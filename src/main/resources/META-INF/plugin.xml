<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.cornmell.superjump</id>
    <name>SuperJump</name>
    <vendor>com.cornmell</vendor>
    <description><![CDATA[
        <p><b>SuperJump</b> jumps to a website based on the text under the cursor.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <actions>
        <action id="SuperJump" class="com.cornmell.superjump.SuperJumpAction" text="Super Jump" description="Jump to website based on selected text"
                icon="/icons/actionIcon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl 9"/>
        </action>

        <action id="SuperJumpGit" class="com.cornmell.superjump.SuperJumpAction" text="Super Jump to Git source repository" description="Jump to git repo based on file and line number"
                icon="/icons/actionIcon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl 0"/>
        </action>

        <action
            id="SuperJump.WhatsNew"
            class="com.cornmell.superjump.actions.WhatsNewAction"
            text="What's New"
            description="View what's new in SuperJump">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            instance="com.cornmell.superjump.settings.SuperJumpConfigurable"
            id="com.cornmell.superjump.settings.SuperJumpConfigurable"
            displayName="SuperJump"/>
    </extensions>

</idea-plugin>

